<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="455.0" prefWidth="250.0" style="-fx-background-color: #1E1E1E; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.prd_previewController">
   <children>
      <Label fx:id="prdName" alignment="TOP_LEFT" layoutX="10.0" layoutY="220.0" onMouseClicked="#handleBidBtn" prefHeight="54.0" prefWidth="215.0" style="-fx-cursor: hand;" text="Product name" textFill="WHITE" wrapText="true">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label fx:id="currentPrice" layoutX="11.0" layoutY="290.0" prefHeight="33.0" prefWidth="203.0" style="-fx-background-color: #3dd35b; -fx-background-radius: 10;" text="150.00 USD" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <padding>
            <Insets left="7.0" />
         </padding>
      </Label>
      <Button fx:id="Bid" layoutX="25.0" layoutY="399.0" mnemonicParsing="false" onMouseClicked="#handleBidBtn" prefHeight="22.0" prefWidth="204.0" styleClass="action-btn-search" stylesheets="@filter.css" text="Start Bidding" />
      <StackPane layoutX="10.0" layoutY="40.0" prefHeight="165.0" prefWidth="230.0" style="-fx-background-color: #1E1E1E; -fx-border-color: #444444;">
         <children>
            <ImageView fx:id="prdImage" fitHeight="165.0" fitWidth="230.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER" />
         </children>
      </StackPane>
      <Label fx:id="auctionStatus" layoutX="10.0" layoutY="10.0" prefHeight="22.0" prefWidth="148.0" style="-fx-background-color: grey; -fx-background-radius: 10;" text="Auction Status" textFill="WHITE">
         <font>
            <Font name="System Bold" size="10.0" />
         </font>
         <padding>
            <Insets left="7.0" />
         </padding>
      </Label>
      <Label fx:id="categories" layoutX="11.0" layoutY="330.0" opacity="0.5" prefHeight="18.0" prefWidth="100.0" style="-fx-background-color: grey; -fx-background-radius: 5;" text="categories" textFill="WHITE">
         <font>
            <Font name="System Bold" size="10.0" />
         </font>
         <padding>
            <Insets left="7.0" />
         </padding>
      </Label>
   </children>
</AnchorPane>
