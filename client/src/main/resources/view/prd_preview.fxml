<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane onMouseClicked="#handleBidBtn" prefHeight="265.0" prefWidth="347.0" style="-fx-background-color: #1E1E1E;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.prd_previewController">
   <children>
      <StackPane prefHeight="195.0" prefWidth="347.0" style="-fx-background-color: #2c2c2c;">
         <children>
            <ImageView fx:id="prdImage" fitHeight="195.0" fitWidth="347.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER" />
         </children>
      </StackPane>
      <Label fx:id="prdName" alignment="TOP_LEFT" layoutX="7.0" layoutY="196.0" onMouseClicked="#handleBidBtn" prefHeight="25.0" prefWidth="330.0" style="-fx-cursor: hand;" text="Product name" textFill="WHITE" wrapText="true">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="currentPrice" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="154.0" layoutY="214.0" onMouseClicked="#handleBidBtn" prefHeight="32.0" prefWidth="185.0" text="150.00 USD" textFill="WHITE">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
         <padding>
            <Insets left="7.0" />
         </padding>
      </Label>
      <Label fx:id="auctionStatus" layoutX="10.0" layoutY="10.0" opacity="0.7" prefHeight="22.0" prefWidth="148.0" style="-fx-background-color: grey; -fx-background-radius: 8;" text="Auction Status" textFill="WHITE">
         <font>
            <Font name="System Bold" size="10.0" />
         </font>
         <padding>
            <Insets left="7.0" />
         </padding>
      </Label>
      <Label fx:id="categories" layoutX="7.0" layoutY="214.0" onMouseClicked="#handleBidBtn" prefHeight="18.0" prefWidth="100.0" text="by Someone" textFill="#b9b6b6">
         <font>
            <Font size="10.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
