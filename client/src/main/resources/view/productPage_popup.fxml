<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #1E1E1E;" stylesheets="@filter.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.filterController">
   <children>
      <Label layoutX="25.0" layoutY="26.0" prefHeight="25.0" prefWidth="190.0" text="Bid Increment" textFill="WHITE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Label layoutX="25.0" layoutY="137.0" prefHeight="25.0" prefWidth="190.0" text="Ceiling Price" textFill="WHITE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <TextField fx:id="ceilling_price" layoutX="25.0" layoutY="176.0" prefHeight="37.0" prefWidth="332.0" promptText="Insert amount" style="-fx-background-color: #2b2b2b; -fx-border-color: #ff8e1f; -fx-background-radius: 20; -fx-border-radius: 20;" styleClass="text-field">
         <padding>
            <Insets left="13.0" />
         </padding></TextField>
      <AnchorPane layoutY="540.0" prefHeight="60.0" prefWidth="1000.0" style="-fx-background-color: #000000;">
         <children>
            <Button fx:id="searchBtn" layoutX="508.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleCustomSearch" prefHeight="30.0" prefWidth="125.0" styleClass="action-btn-search" text="Set Auto-bid">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="backBtn" alignment="CENTER" layoutX="365.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleBackBtn" prefHeight="30.0" prefWidth="125.0" styleClass="action-btn-back" text="Cancel" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <Label fx:id="status" layoutX="14.0" layoutY="509.0" prefHeight="25.0" prefWidth="204.0" text="Status" textFill="WHITE">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="price_step" layoutX="25.0" layoutY="65.0" prefHeight="37.0" prefWidth="332.0" promptText="Insert amount" style="-fx-background-color: #2b2b2b; -fx-border-color: #ff8e1f; -fx-background-radius: 20; -fx-border-radius: 20;" styleClass="text-field">
         <padding>
            <Insets left="13.0" />
         </padding>
      </TextField>
   </children>
</AnchorPane>
