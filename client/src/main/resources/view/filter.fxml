<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #1E1E1E;" stylesheets="@filter.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.filterController">
   <children>

      <Label layoutX="25.0" layoutY="26.0" prefHeight="25.0" prefWidth="190.0" text="Categories" textFill="WHITE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <ToggleButton fx:id="art" layoutX="25.0" layoutY="65.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Art" />
      <ToggleButton fx:id="electronics" layoutX="172.0" layoutY="65.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Electronics" />
      <ToggleButton fx:id="vehicle" layoutX="318.0" layoutY="65.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Vehicle" />
      <ToggleButton fx:id="real_estate" layoutX="464.0" layoutY="65.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Real Estate" />

      <Label layoutX="25.0" layoutY="137.0" prefHeight="25.0" prefWidth="190.0" text="Price Range" textFill="WHITE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <ToggleButton fx:id="price1" layoutX="25.0" layoutY="176.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Under 1M" />
      <ToggleButton fx:id="price2" layoutX="172.0" layoutY="176.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="1M - 10M" />
      <ToggleButton fx:id="price3" layoutX="318.0" layoutY="176.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Over 10M" />

      <Label layoutX="25.0" layoutY="235.0" prefHeight="25.0" prefWidth="204.0" text="Or choose a suitable price range" textFill="WHITE">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="lowest" layoutX="244.0" layoutY="235.0" promptText="Lowest price (VNĐ)" style="-fx-background-color: #2b2b2b; -fx-border-color: #ff8e1f; -fx-background-radius: 7; -fx-border-radius: 7;" styleClass="text-field" stylesheets="@filter.css" />
      <TextField fx:id="highest" layoutX="439.0" layoutY="235.0" promptText="Highest price (VNĐ)" style="-fx-background-color: #2b2b2b; -fx-border-color: #ff8e1f; -fx-background-radius: 7; -fx-border-radius: 7;" styleClass="text-field" />
      <Line endX="-26.0" endY="0.5" layoutX="465.0" layoutY="248.0" startX="-70.0" startY="0.5" stroke="#ff8e1f" />

      <Label layoutX="25.0" layoutY="288.0" prefHeight="25.0" prefWidth="190.0" text="Auction Status" textFill="WHITE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <ToggleButton fx:id="bidding" layoutX="25.0" layoutY="321.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Bidding" />
      <ToggleButton fx:id="newly_listed" layoutX="172.0" layoutY="321.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Newly Listed" />
      <ToggleButton fx:id="ending_soon" layoutX="318.0" layoutY="321.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Ending Soon" />
      <ToggleButton fx:id="upcoming" layoutX="464.0" layoutY="321.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Upcoming" />
      <ToggleButton fx:id="ended" layoutX="608.0" layoutY="323.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="126.0" styleClass="filter-btn" text="Ended" />

      <Label layoutX="25.0" layoutY="385.0" prefHeight="25.0" prefWidth="190.0" text="Auction ID" textFill="WHITE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <TextField fx:id="auctionID" layoutX="25.0" layoutY="415.0" prefHeight="27.0" prefWidth="285.0" promptText="Insert auction ID" style="-fx-background-color: #2b2b2b; -fx-border-color: #ff8e1f; -fx-background-radius: 7; -fx-border-radius: 7;" styleClass="text-field" />

      <AnchorPane layoutY="540.0" prefHeight="60.0" prefWidth="1000.0" style="-fx-background-color: #000000;">
         <children>
            <Button fx:id="searchBtn" layoutX="508.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleCustomSearch" prefHeight="30.0" prefWidth="125.0" styleClass="action-btn-search" text="Custom Search">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="backBtn" alignment="CENTER" layoutX="365.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleBackBtn" prefHeight="30.0" prefWidth="125.0" styleClass="action-btn-back" text="Back" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <Button fx:id="clear_btn" alignment="CENTER" layoutX="26.0" layoutY="467.0" mnemonicParsing="false" onAction="#handleClearBtn" prefHeight="30.0" prefWidth="125.0" style="-fx-border-color: red;" styleClass="action-btn-back" text="Clear All" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
