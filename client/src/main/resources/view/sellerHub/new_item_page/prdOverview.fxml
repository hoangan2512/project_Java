<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="630.0" prefWidth="1030.0" style="-fx-background-color: #000000;" stylesheets="@graphicInfo.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.sellerHub.new_item_page.prdOverview">
   <children>
      <Label fx:id="InfoType" alignment="CENTER" layoutX="214.0" layoutY="199.0" prefHeight="43.0" prefWidth="632.0" text="Your product has been successfully created （￣︶￣）↗　" textAlignment="CENTER" textFill="WHITE" visible="false">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Button fx:id="previewBtn" layoutX="279.0" layoutY="323.0" mnemonicParsing="false" onAction="#handlePreviewBtn" prefHeight="43.0" prefWidth="474.0" style="-fx-background-color: #ff8e1f; -fx-cursor: hand; -fx-background-radius: 20px;" text="Preview product page" visible="false">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Label fx:id="Status" alignment="TOP_LEFT" layoutX="610.0" layoutY="389.0" prefHeight="70.0" prefWidth="395.0" text="Status" textFill="WHITE" visible="false">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="prdName" layoutX="680.0" layoutY="112.0" prefHeight="60.0" prefWidth="279.0" text="Product name" textFill="WHITE">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Label>
      <Label fx:id="priceLabel" layoutX="680.0" layoutY="179.0" prefHeight="26.0" prefWidth="270.0" text="Current price" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="currentPrice" layoutX="680.0" layoutY="195.0" prefHeight="40.0" prefWidth="290.0" text="Current price" textFill="#0bff00">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      <Button fx:id="Bid" layoutX="670.0" layoutY="468.0" mnemonicParsing="false" prefHeight="10.0" prefWidth="231.0" style="-fx-background-color: #ff8e1f; -fx-background-radius: 30px;" text="Place a bid">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Button>
      <TextField fx:id="bidAmount" layoutX="64.0" layoutY="467.0" prefHeight="35.0" prefWidth="540.0" promptText="Insert a number" style="-fx-background-color: #2b2b2b; -fx-background-radius: 20px;" styleClass="priceField" stylesheets="@../../prdPage.css">
         <font>
            <Font size="16.0" />
         </font>
      </TextField>
      <Label fx:id="timeLabel" layoutX="64.0" layoutY="438.0" prefHeight="25.0" prefWidth="126.0" text="Time Remaining:" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="timeLeft" layoutX="190.0" layoutY="438.0" prefHeight="24.0" prefWidth="476.0" text="00:00:00" textFill="WHITE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <StackPane fx:id="imgPane" layoutX="64.0" layoutY="103.0" prefHeight="315.0" prefWidth="540.0" style="-fx-background-color: #1E1E1E;" styleClass="prd_img">
         <children>
            <ImageView fx:id="prdImage" fitHeight="310.0" fitWidth="530.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>
      <Label fx:id="discriptionLabel" layoutX="680.0" layoutY="247.0" prefHeight="26.0" prefWidth="270.0" text="Discription" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="prdDiscription" alignment="TOP_LEFT" layoutX="680.0" layoutY="267.0" prefHeight="156.0" prefWidth="270.0" text="product discription" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
